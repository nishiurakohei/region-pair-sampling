# OS / editor
.DS_Store
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
.venv-gpu/
.train_venv/
venv/
env/

# Data — mask images are large and dataset-specific; not tracked in git.
# Place your masks under data/masks/ locally (not committed).
data/masks/*
!data/masks/.gitkeep

data/masks_region_pair_subset_v1/*
!data/masks_region_pair_subset_v1/.gitkeep

data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/samples/*
!data/samples/.gitkeep

# Outputs — all experiment results are generated at runtime; not tracked in git.
outputs/*
!outputs/.gitkeep

# Model weights
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.safetensors
*.zanj

# Maze external-validation sources/data are reproducibly restored from docs/NEXT_TASK.md.
hard_maze/external_validation/upstream/
hard_maze/external_validation/data/

# Keep compact metrics/reports, not generated model state or pair-level dumps.
hard_maze/results_external/**/checkpoints/
hard_maze/results_external/**/per_pair_predictions.csv
hard_maze/results_external/**/research_memory.yaml
hard_maze/results_phase*/**/checkpoints/
hard_maze/results_phase*/**/per_pair_predictions.csv
hard_maze/results_phase*/**/figures/failure_cases/
hard_maze/results_external/stage0_5_*pilot*/
hard_maze/results_external/stage1_aux_pilot/
